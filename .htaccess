RewriteEngine on
RewriteCond $1 !^(index\.php|resources|robots\.txt)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php/$1 [L,QSA]
php_value memory_limit 25000M
php_value post_max_size 1000000M
php_value upload_max_filesize 3000000M
php_value max_input_vars 16000000
php_value suhosin.post.max_vars 160000000
php_value suhosin.request.max_vars 160000000
AddDefaultCharset UTF-8